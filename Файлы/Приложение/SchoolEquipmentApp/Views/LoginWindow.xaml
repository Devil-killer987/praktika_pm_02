<Window x:Class="SchoolEquipmentApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему - Учёт оборудования" Height="380" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Background="#f0f0f0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
            <StackPanel>
                <TextBlock Text="📋 Учёт компьютерного оборудования" 
                           FontSize="20" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Авторизация в системе" 
                           FontSize="14" Foreground="White" Opacity="0.8"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Login Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <Border Background="White" CornerRadius="8" Padding="25,30" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Login -->
                    <TextBlock Text="Логин" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLogin" Height="30" FontSize="14" 
                             Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15" Padding="8,3"/>

                    <!-- Password -->
                    <TextBlock Text="Пароль" FontWeight="Bold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" Height="30" FontSize="14"
                                 Margin="0,0,0,20" Padding="8,3"/>

                    <!-- Login Button -->
                    <Button Content="Войти" 
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="40" FontSize="16"
                            IsDefault="True"/>

                    <TextBlock Text="Тестовые данные: admin / password123" 
                               FontSize="11" Foreground="#666" 
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            
        </StackPanel>
    </Grid>
</Window>