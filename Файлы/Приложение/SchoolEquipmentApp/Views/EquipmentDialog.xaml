<Window x:Class="SchoolEquipmentApp.Views.EquipmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оборудование" Height="650" Width="600"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Оборудование" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- Инвентарный номер -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Инв. номер:*" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Column="1" Text="{Binding InventoryNumber, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
            </Grid>

            <!-- Тип оборудования -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Тип:*" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding EquipmentTypes}" 
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding EquipmentTypeId}" Height="28"/>
            </Grid>

            <!-- Производитель -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Производитель:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Manufacturer}" Height="28"/>
            </Grid>

            <!-- Модель -->
            <Grid Grid.Row="4" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Модель:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Model}" Height="28"/>
            </Grid>

            <!-- Серийный номер -->
            <Grid Grid.Row="5" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Серийный номер:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding SerialNumber}" Height="28"/>
            </Grid>

            <!-- Дата покупки -->
            <Grid Grid.Row="6" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Дата покупки:" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding PurchaseDate}" Height="28"/>
            </Grid>

            <!-- Окончание гарантии -->
            <Grid Grid.Row="7" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Гарантия до:" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding WarrantyEnd}" Height="28"/>
            </Grid>

            <!-- Статус -->
            <Grid Grid.Row="8" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Статус:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Statuses}" 
                          SelectedItem="{Binding Status}" Height="28"/>
            </Grid>

            <!-- Характеристики -->
            <GroupBox Grid.Row="9" Header="Характеристики" Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="+ Добавить характеристику" 
                            Command="{Binding AddSpecificationCommand}"
                            Style="{StaticResource PrimaryButton}" Width="180"
                            HorizontalAlignment="Left" Margin="5,5,0,5"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Specifications}" 
                              AutoGenerateColumns="False" MaxHeight="150" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding CustomName}" Width="150"/>
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✖" Command="{Binding DataContext.RemoveSpecificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Width="25" Height="25"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- Примечания -->
            <Grid Grid.Row="10" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Примечания:" VerticalAlignment="Top"/>
                <TextBox Grid.Column="1" Text="{Binding Notes}" Height="60" 
                         TextWrapping="Wrap" AcceptsReturn="True"/>
            </Grid>

            <!-- Кнопки -->
            <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                        Style="{StaticResource SuccessButton}" Width="100"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" 
                        Style="{StaticResource DangerButton}" Width="100"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>