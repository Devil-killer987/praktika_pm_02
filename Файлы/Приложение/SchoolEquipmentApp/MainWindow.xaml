<Window x:Class="SchoolEquipmentApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт компьютерного оборудования в школе" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Height="40">
            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"/>
            <Separator/>
            <Button Content="🏫 Здания" Command="{Binding AddBuildingCommand}" Style="{StaticResource SuccessButton}"/>
            <Button Content="✏️" Command="{Binding EditBuildingCommand}" Style="{StaticResource PrimaryButton}" Width="30"/>
            <Button Content="🗑️" Command="{Binding DeleteBuildingCommand}" Style="{StaticResource DangerButton}" Width="30"/>
            <Separator/>
            <Button Content="📚 Кабинеты" Command="{Binding AddClassroomCommand}" Style="{StaticResource SuccessButton}"/>
            <Button Content="✏️" Command="{Binding EditClassroomCommand}" Style="{StaticResource PrimaryButton}" Width="30"/>
            <Button Content="🗑️" Command="{Binding DeleteClassroomCommand}" Style="{StaticResource DangerButton}" Width="30"/>
            <Separator/>
            <Button Content="💻 Оборудование" Command="{Binding AddEquipmentCommand}" Style="{StaticResource SuccessButton}"/>
            <Button Content="✏️" Command="{Binding EditEquipmentCommand}" Style="{StaticResource PrimaryButton}" Width="30"/>
            <Button Content="🗑️" Command="{Binding DeleteEquipmentCommand}" Style="{StaticResource DangerButton}" Width="30"/>
            <Separator/>
            <Button Content="📦 Типы" Command="{Binding AddEquipmentTypeCommand}" Style="{StaticResource SuccessButton}"/>
            <Button Content="✏️" Command="{Binding EditEquipmentTypeCommand}" Style="{StaticResource PrimaryButton}" Width="30"/>
            <Button Content="🗑️" Command="{Binding DeleteEquipmentTypeCommand}" Style="{StaticResource DangerButton}" Width="30"/>
            <Separator/>
            <Button Content="🚪 Выход" Command="{Binding LogoutCommand}" Style="{StaticResource DangerButton}"/>
        </ToolBar>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Buildings and Classrooms -->
            <Border Grid.Column="0" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🏫 Структура" FontWeight="Bold" 
                               Margin="5" FontSize="14"/>

                    <TreeView Grid.Row="1" x:Name="treeView" Margin="2">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Classrooms}">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Number}" Margin="5,0,0,0"/>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Right Panel - Equipment List -->
            <Border Grid.Column="1" BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <TextBlock Text="💻 Оборудование" FontWeight="Bold" FontSize="14" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#666"
                                   VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgEquipment" 
                              ItemsSource="{Binding Equipment}"
                              SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Инв. номер" Binding="{Binding InventoryNumber}" Width="100"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding EquipmentTypeName}" Width="100"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="150"/>
                            <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="120"/>
                            <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialNumber}" Width="120"/>
                            <DataGridTextColumn Header="Дата покупки" Binding="{Binding PurchaseDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Пользователь:"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding UserName}" FontWeight="Bold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Роль:"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding UserRole}" FontWeight="Bold" Foreground="#2196F3"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>